{
  "name": "solarpro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SolarPro Clean Energy Systems - Fullstack Monorepo",
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix solarpannel-frontend",
    "start": "node backend/server.js",
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --prefix backend",
