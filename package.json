    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix solarpannel-frontend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mongoose": "^9.11.2"
  }
}
