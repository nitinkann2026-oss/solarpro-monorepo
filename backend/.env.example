# Port on which the Express server will listen
PORT=5000

# MongoDB Connection String (leave as default for local MongoDB, or paste your MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/solarpro?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/solarpro

# Environment mode (development / production)
NODE_ENV=development
