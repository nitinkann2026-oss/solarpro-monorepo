{
  "version": 2,
  "buildCommand": "npm run build --prefix solarpannel-frontend",
  "outputDirectory": "solarpannel-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
